{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "worker": "node src/workers/analytics.worker.js",
    "migration:show": "node -r dotenv/config ./node_modules/typeorm/cli.js migration:show -d src/config/database.js",
    "test": "jest --runInBand --testPathIgnorePatterns=tests/integration",
    "test:integration": "dotenv -e .env.test -- jest --runInBand tests/integration",
    "test:all": "dotenv -e .env.test -- jest --runInBand",
    "migration:run": "node -r dotenv/config ./node_modules/typeorm/cli.js migration:run -d src/config/database.js",
    "start": "node src/server.js"
  },
