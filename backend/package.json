    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
